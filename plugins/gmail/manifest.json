{
  "id": "gmail",
  "name": "Gmail mail flow",
  "version": "1.0.0",
  "apiVersion": 1,
  "description": "Ingest job leads from Gmail and send explicit, deduplicated mail through your OAuth account.",
  "hooks": ["ingest", "notify"],
  "requiredEnv": ["GMAIL_CLIENT_ID", "GMAIL_CLIENT_SECRET", "GMAIL_REFRESH_TOKEN"],
  "allowedHosts": ["oauth2.googleapis.com", "gmail.googleapis.com"],
  "skill": "skill.md",
  "humanInTheLoop": true,
  "homepage": "https://developers.google.com/gmail/api"
}
